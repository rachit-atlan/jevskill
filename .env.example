# TypeSafe AI key for jev. Required for the jev arm and `npm run route`.
TYPESAFE_API_KEY=
# Optional: log experiments to Braintrust. Omit to run fully offline.
BRAINTRUST_API_KEY=

# Atlan Registry (atlanai SDK). One key serves management + tracing. Required for `dataset-push` and `atlan-eval`.
ATLAN_API_KEY=
ATLAN_WORKSPACE_ID=
ATLAN_BASE_URL=https://api.atlan.com
# Optional: register Claude Code as a harness in the registry and set its id so experiments bind to it
ATLAN_SUBJECT_KIND=harness
ATLAN_SUBJECT_ID=
